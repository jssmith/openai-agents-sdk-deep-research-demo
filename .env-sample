## Your OpenAI API key (required)

OPENAI_API_KEY='your-openai-api-key'


## By default, the Worker and Client will connect to a local Temporal server (127.0.0.1:7233),
## on namespace 'default'. This is fine for development purposes and local testing.
##
## To use Temporal Cloud instead, uncomment the following:

# TEMPORAL_PROFILE='cloud'

## And follow instructions in the README for running demo on Temporal Cloud.

## Alternately, configure these variables.

# TEMPORAL_PROFILE='default'
# TEMPORAL_ADDRESS='127.0.0.1:7233'
# TEMPORAL_NAMESPACE='default'
# TEMPORAL_API_KEY=''


## The task queue to use for the worker

# TEMPORAL_TASK_QUEUE='research-queue'


## The Triage agent is responsible for deciding whether claryfing questions are needed, or
## if the initial query was already specific enough. This is nice in a real world scenario, but
## ain't great for demo purposes, where we _do_ want to show the clarifying agent in action.
## Setting this option to 'Y' will force the triage agent to ALWAYS ask for clarifying questions.

BYPASS_TRIAGE_AGENT='Y'


## Demo runtime controls
##
## Clean, recording-friendly defaults:
## - no simulated process crash
## - no simulated clarification retry
## - no simulated data warehouse retry failure
## - enough worker concurrency that one slow activity does not block the queue
## - use a cached report image instead of waiting on live image generation

DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES='4'
DEMO_SEARCH_BRANCH_PROCESS_FAILURES='0'
DEMO_CLARIFICATION_RETRY_FAILURES='0'
DEMO_DATA_WAREHOUSE_RETRY_FAILURES='0'
DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='1'

## Optional: skip live image generation by pointing at a cached image.
## temp_images/ is gitignored; on a fresh checkout, generate one image with the
## live path first, then set this to the resulting file (e.g.
## temp_images/generated_image_YYYYMMDD_HHMMSS_xxxxx.jpeg) for fast subsequent runs.
# DEMO_RESEARCH_IMAGE_PATH=''

## To show the failure/recovery moment again, override these for that run:
##
## DEMO_SEARCH_BRANCH_PROCESS_FAILURES='1'
## DEMO_SEARCH_BRANCH_FAILURE_AFTER_SECONDS='4'
## DEMO_DATA_WAREHOUSE_RETRY_FAILURES='1'
## DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='8'
## DEMO_RESEARCH_IMAGE_PATH=''
