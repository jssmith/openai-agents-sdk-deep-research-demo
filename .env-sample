## Your OpenAI API key (required)

OPENAI_API_KEY='your-openai-api-key'


## By default, the worker and the FastAPI backend connect to a local Temporal server
## (127.0.0.1:7233) on namespace 'default'. To use Temporal Cloud instead,
## uncomment the following:

# TEMPORAL_PROFILE='cloud'

## And follow instructions in the README for running on Temporal Cloud.

## Alternately, configure these variables directly:

# TEMPORAL_PROFILE='default'
# TEMPORAL_ADDRESS='127.0.0.1:7233'
# TEMPORAL_NAMESPACE='default'
# TEMPORAL_API_KEY=''


## Task queue (default: research-queue)

# TEMPORAL_TASK_QUEUE='research-queue'


## Demo profile
## ------------
## clean = no injected warehouse failures
## recovery = attempts 1-2 fail, attempt 3 succeeds

DEMO_PROFILE='clean'

## Model calls have a layered synthesis fallback so the workflow ALWAYS returns
## a report:
##
##   attempt 1        -> primary cloud model (ORCHESTRATOR_MODEL, e.g. gpt-5)
##   attempt 2        -> faster cloud fallback (ORCHESTRATOR_FALLBACK_MODEL)
##   attempt >= LOCAL -> local model via Ollama (DEMO_MODEL_LOCAL)
##   floor            -> deterministic, no-model report assembled from the
##                       research already gathered (always succeeds, instant)
##
## Timeout invariant (keep when tuning):
##   HTTP_TIMEOUT (90) < START_TO_CLOSE (100)  — abandoned request can't overlap its retry

DEMO_MODEL_START_TO_CLOSE_SECONDS='100'
DEMO_MODEL_SCHEDULE_TO_CLOSE_SECONDS='240'
DEMO_MODEL_RETRY_DELAY_SECONDS='3'
DEMO_MODEL_MAX_ATTEMPTS='3'
DEMO_MODEL_HTTP_TIMEOUT_SECONDS='90'
ORCHESTRATOR_FALLBACK_MODEL='gpt-5-mini'
DEMO_IMAGE_MAX_ATTEMPTS='1'

## Local synthesis fallback (layer 3), served over an OpenAI-compatible endpoint.
## Requires Ollama: `ollama pull qwen2.5:14b-instruct && ollama serve`.
## If Ollama is down, attempt 3 fails fast (local HTTP timeout) and the
## deterministic floor still returns a valid report. Set DEMO_MODEL_LOCAL='' to
## disable the local layer entirely (attempts fall straight through to the floor).

DEMO_MODEL_LOCAL='qwen2.5:14b-instruct'
DEMO_MODEL_LOCAL_BASE_URL='http://localhost:11434/v1'
DEMO_MODEL_LOCAL_HTTP_TIMEOUT_SECONDS='90'
DEMO_MODEL_LOCAL_ATTEMPT='3'

## Optional hard wall-clock cap on the whole run. DISABLED by default (0) to keep
## the Temporal history clean — the never-fail floor and per-call timeouts
## already bound a run. When set > 0, a SINGLE timer races the orchestrator and
## forces the deterministic floor if it fires. Keep it > SCHEDULE_TO_CLOSE (240).

DEMO_TOTAL_BUDGET_SECONDS='0'


## Worker concurrency. 4 is enough that one slow activity does not block
## the queue while still being easy to reason about in a demo.

DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES='4'


## Data warehouse failure injection
## --------------------------------
##
## The DataWarehouseLookup activity has two demo knobs:
##
##   DEMO_DATA_WAREHOUSE_RETRY_FAILURES — number of attempts that fail
##     before the activity succeeds. 0 = always succeed on attempt 1.
##     1 = attempt 1 fails, attempt 2 succeeds. 8 = attempts 1-8 fail,
##     attempt 9 succeeds. The activity's retry policy allows up to 10
##     attempts with a 4-second backoff (see orchestrator_agent.py), so
##     9 is the largest "always recovers" value (attempt 10 succeeds).
##     10 or more will exhaust retries and fail the workflow.
##
##   DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS — artificial latency on
##     attempt 1 only. Subsequent attempts use a fixed 0.6s delay.
##     1s = brisk and demo-paced.
##
## Default: clean (no retries, brisk first attempt).

DEMO_DATA_WAREHOUSE_RETRY_FAILURES='0'
DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='1'


## Optional: skip live image generation by pointing at a cached image.
## temp_images/ is gitignored; on a fresh checkout, generate one image with the
## live path first, then set this to the resulting file (e.g.
## temp_images/generated_image_YYYYMMDD_HHMMSS_xxxxx.jpeg) for fast subsequent runs.

# DEMO_RESEARCH_IMAGE_PATH=''


## Demo recipe — recoverable activity failure
## -------------------------------------------
##
## Temporal retries the lookup. Audience watches 8 failed attempts
## (~38s end-to-end including the attempts themselves and ~32s of
## 4-second retry backoffs), then attempt 9 succeeds and the workflow
## continues without rerunning earlier work.
##
##     DEMO_DATA_WAREHOUSE_RETRY_FAILURES='8'
##     DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='1'
##
## See README.md → "Failure injection" for narration and what to highlight
## in the Temporal UI. A worker-death-mid-flight beat is in progress; see
## KNOWN_ISSUES.md for why it's not documented as a turn-key recipe yet.
