## Your OpenAI API key (required)

OPENAI_API_KEY='your-openai-api-key'


## By default, the Worker and BFF connect to a local Temporal server
## (127.0.0.1:7233) on namespace 'default'. To use Temporal Cloud instead,
## uncomment the following:

# TEMPORAL_PROFILE='cloud'

## And follow instructions in the README for running on Temporal Cloud.

## Alternately, configure these variables directly:

# TEMPORAL_PROFILE='default'
# TEMPORAL_ADDRESS='127.0.0.1:7233'
# TEMPORAL_NAMESPACE='default'
# TEMPORAL_API_KEY=''


## Task queue (default: research-queue)

# TEMPORAL_TASK_QUEUE='research-queue'


## Demo runtime controls
##
## Clean, recording-friendly defaults:
## - no simulated data warehouse retry failure
## - enough worker concurrency that one slow activity does not block the queue
## - live image generation (set DEMO_RESEARCH_IMAGE_PATH to skip)

DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES='4'
DEMO_DATA_WAREHOUSE_RETRY_FAILURES='0'
DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='1'

## Optional: skip live image generation by pointing at a cached image.
## temp_images/ is gitignored; on a fresh checkout, generate one image with the
## live path first, then set this to the resulting file (e.g.
## temp_images/generated_image_YYYYMMDD_HHMMSS_xxxxx.jpeg) for fast subsequent runs.
# DEMO_RESEARCH_IMAGE_PATH=''

## To show the failure/recovery moment again, override these for that run:
##
## DEMO_DATA_WAREHOUSE_RETRY_FAILURES='8'
## (worker death is driven manually with scripts/crash-worker.)
