## Your OpenAI API key (required)

OPENAI_API_KEY='your-openai-api-key'


## By default, the worker and the FastAPI backend connect to a local Temporal server
## (127.0.0.1:7233) on namespace 'default'. To use Temporal Cloud instead,
## uncomment the following:

# TEMPORAL_PROFILE='cloud'

## And follow instructions in the README for running on Temporal Cloud.

## Alternately, configure these variables directly:

# TEMPORAL_PROFILE='default'
# TEMPORAL_ADDRESS='127.0.0.1:7233'
# TEMPORAL_NAMESPACE='default'
# TEMPORAL_API_KEY=''


## Task queue (default: research-queue)

# TEMPORAL_TASK_QUEUE='research-queue'


## Model calls fall back across Temporal retries of the model activity:
##
##   attempt 1        -> primary cloud model (ORCHESTRATOR_MODEL, e.g. gpt-5)
##   attempt 2        -> faster cloud fallback (ORCHESTRATOR_FALLBACK_MODEL)
##   attempt >= LOCAL -> local model via Ollama (DEMO_MODEL_LOCAL); Ollama
##                       can't run web search, so research workers answer from
##                       the model's own knowledge, labeled "From model
##                       knowledge, not a web search:"
##
## If every attempt fails, the workflow fails and the UI says so. Timeouts are
## sized so a slow-but-working call is never cut off.
##
## Fallback only happens on retryable failures: timeouts, connection errors,
## 408/409/429 and 5xx. Non-retryable 4xx responses (bad model name, auth,
## context too long) stop Temporal's retries, so the run fails without trying
## the cloud fallback or local model.
##
## Timeout invariants (the worker validates these at startup):
##   HTTP_TIMEOUT (90) < START_TO_CLOSE (100)  — abandoned request can't overlap its retry
##   (LOCAL_ATTEMPT-1) * (START_TO_CLOSE + RETRY_DELAY) + LOCAL_HTTP_TIMEOUT
##     <= SCHEDULE_TO_CLOSE                    — 2*(100+3)+90 = 296 <= 300, so the
##                                               local layer gets its full timeout
##                                               even if both cloud attempts hang

DEMO_MODEL_START_TO_CLOSE_SECONDS='100'
DEMO_MODEL_SCHEDULE_TO_CLOSE_SECONDS='300'
DEMO_MODEL_RETRY_DELAY_SECONDS='3'
DEMO_MODEL_MAX_ATTEMPTS='3'
DEMO_MODEL_HTTP_TIMEOUT_SECONDS='90'
ORCHESTRATOR_FALLBACK_MODEL='gpt-5-mini'
DEMO_IMAGE_MAX_ATTEMPTS='1'

## Local fallback (layer 3), served over an OpenAI-compatible endpoint.
## Requires Ollama: `ollama pull qwen2.5:14b-instruct && ollama serve`.
## If Ollama is down, attempt 3 fails fast (connection refused) and the run
## fails. Set DEMO_MODEL_LOCAL='' to disable the local layer entirely.

DEMO_MODEL_LOCAL='qwen2.5:14b-instruct'
DEMO_MODEL_LOCAL_BASE_URL='http://localhost:11434/v1'
DEMO_MODEL_LOCAL_HTTP_TIMEOUT_SECONDS='90'
DEMO_MODEL_LOCAL_ATTEMPT='3'


## Worker concurrency. 4 is enough that one slow activity does not block
## the queue while still being easy to reason about in a demo.

DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES='4'


## Data warehouse failure injection (the retry beat)
## ------------------------------------------------
##
## DEMO_DATA_WAREHOUSE_RETRY_FAILURES is how many DataWarehouseLookup attempts
## fail before one succeeds. 0 = clean run. 8 = attempts 1-8 fail and attempt 9
## succeeds, about 40s of retries (each attempt takes 1s, with 4s between
## them). Valid range 0-9: the retry policy allows 10 attempts, and the worker
## rejects a value that would exhaust them. Leave it unset here and pass it at
## launch instead:
##
##     scripts/start-demo --warehouse-failures 8

# DEMO_DATA_WAREHOUSE_RETRY_FAILURES='0'


## Optional: skip live image generation by pointing at a cached image, e.g.
## for rehearsals. It must be a file under temp_images/ (gitignored), such as
## one an earlier live run generated; the worker refuses to start otherwise.

# DEMO_RESEARCH_IMAGE_PATH='temp_images/generated_image_YYYYMMDD_HHMMSS_xxxxxx.jpeg'
