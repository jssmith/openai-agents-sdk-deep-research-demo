## Your OpenAI API key (required)

OPENAI_API_KEY='your-openai-api-key'


## By default, the worker and the FastAPI backend connect to a local Temporal server
## (127.0.0.1:7233) on namespace 'default'. To use Temporal Cloud instead,
## uncomment the following:

# TEMPORAL_PROFILE='cloud'

## And follow instructions in the README for running on Temporal Cloud.

## Alternately, configure these variables directly:

# TEMPORAL_PROFILE='default'
# TEMPORAL_ADDRESS='127.0.0.1:7233'
# TEMPORAL_NAMESPACE='default'
# TEMPORAL_API_KEY=''


## Task queue (default: research-queue)

# TEMPORAL_TASK_QUEUE='research-queue'


## Worker concurrency. 4 is enough that one slow activity does not block
## the queue while still being easy to reason about in a demo.

DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES='4'


## Data warehouse failure injection
## --------------------------------
##
## The DataWarehouseLookup activity has two demo knobs:
##
##   DEMO_DATA_WAREHOUSE_RETRY_FAILURES — number of attempts that fail
##     before the activity succeeds. 0 = always succeed on attempt 1.
##     1 = attempt 1 fails, attempt 2 succeeds. 8 = attempts 1-8 fail,
##     attempt 9 succeeds. The activity's retry policy allows up to 10
##     attempts with a 4-second backoff (see orchestrator_agent.py), so
##     9 is the largest "always recovers" value (attempt 10 succeeds).
##     10 or more will exhaust retries and fail the workflow.
##
##   DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS — artificial latency on
##     attempt 1 only. Subsequent attempts use a fixed 0.6s delay.
##     1s = brisk and demo-paced. 8s = slow enough to crash the worker
##     mid-attempt with scripts/crash-worker for the worker-death beat.
##
## Default: clean (no retries, brisk first attempt).

DEMO_DATA_WAREHOUSE_RETRY_FAILURES='0'
DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='1'


## Optional: skip live image generation by pointing at a cached image.
## temp_images/ is gitignored; on a fresh checkout, generate one image with the
## live path first, then set this to the resulting file (e.g.
## temp_images/generated_image_YYYYMMDD_HHMMSS_xxxxx.jpeg) for fast subsequent runs.

# DEMO_RESEARCH_IMAGE_PATH=''


## Demo recipes
## ------------
##
## (A) Recoverable activity failure — Temporal retries the lookup.
##     Audience watches 8 failed attempts (~38s end-to-end including the
##     attempts themselves and ~32s of 4-second retry backoffs), then
##     attempt 9 succeeds and the workflow continues without rerunning
##     earlier work.
##
##         DEMO_DATA_WAREHOUSE_RETRY_FAILURES='8'
##         DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='1'
##
## (B) Worker death mid-flight — Temporal moves the activity to a fresh
##     worker. Start two workers behind the same task queue, watch the
##     activity start on one, run scripts/crash-worker against it while
##     it's still on attempt 1, watch it resume on the other worker.
##
##         DEMO_DATA_WAREHOUSE_RETRY_FAILURES='0'
##         DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS='8'
##         DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES='1'
##
##     The orchestrator runs query_data_warehouse and
##     generate_research_image as parallel tool calls. With concurrency
##     of 1 per worker, the two activities land on different workers,
##     so killing the one running the warehouse lookup doesn't also
##     orphan the (slower) image-generation activity.
##
##     Boot both workers with:
##         scripts/start-clean-worker
##         scripts/start-clean-worker 2
##
##     Crash one mid-activity:
##         scripts/crash-worker        # kills .demo-worker-clean.pid
##         scripts/crash-worker 2      # kills .demo-worker-clean-2.pid
##
## See README.md → "Failure injection" for narration and what to highlight
## in the Temporal UI.
