#!/usr/bin/env bash
set -euo pipefail

# Demo-only: SIGKILL the running worker, to show Temporal resuming the run
# after a real process death. Targets the pid in .demo-worker.pid, which
# openai_agents/run_worker.py writes on startup.

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir/.."

pid_file=".demo-worker.pid"

if [[ ! -f "$pid_file" ]]; then
  echo "no pid file at ${pid_file}; is the worker running?" >&2
  exit 1
fi

pid="$(tr -d '[:space:]' <"$pid_file")"
if [[ -z "$pid" || ! "$pid" =~ ^[0-9]+$ ]]; then
  echo "${pid_file}: invalid pid '${pid}'" >&2
  exit 1
fi

if ! kill -0 "$pid" >/dev/null 2>&1; then
  echo "${pid_file}: pid ${pid} is not running" >&2
  exit 1
fi

# A stale pid file must never kill an unrelated process.
command_line="$(ps -p "$pid" -o command= || true)"
if [[ "$command_line" != *"openai_agents/run_worker.py"* ]]; then
  echo "${pid_file}: pid ${pid} does not look like a deep-research worker; refusing" >&2
  echo "  ${command_line}" >&2
  exit 1
fi

echo "crashing worker pid ${pid}" >&2
kill -9 "$pid"
