#!/usr/bin/env bash
set -euo pipefail

# Optional first arg names the instance, so multiple workers can run in parallel
# behind the same task queue: e.g. `scripts/start-clean-worker` then
# `scripts/start-clean-worker 2` writes pid files .demo-worker-clean.pid and
# .demo-worker-clean-2.pid respectively. Use `scripts/crash-worker [name]` to
# target a specific instance for the failure-recovery moment.

instance="${1:-}"
if [[ -n "$instance" ]]; then
  default_pid_file=".demo-worker-clean-${instance}.pid"
else
  default_pid_file=".demo-worker-clean.pid"
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "$script_dir/.." && pwd)"
cd "$repo_dir"

env_file="${DEMO_ENV_FILE:-.env}"

export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/replay-demos-ui-uv-cache}"
export DEMO_WORKER_PID_FILE="${DEMO_WORKER_PID_FILE:-${default_pid_file}}"
export DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES="${DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES:-40}"
export DEMO_DATA_WAREHOUSE_RETRY_FAILURES="${DEMO_DATA_WAREHOUSE_RETRY_FAILURES:-0}"
export DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS="${DEMO_DATA_WAREHOUSE_FIRST_ATTEMPT_SECONDS:-1}"
## DEMO_RESEARCH_IMAGE_PATH is read from .env (or the shell) by the worker
## activity itself. temp_images/ is gitignored, so on a fresh checkout either
## leave the var unset to use live image generation, or set it to a locally-
## cached jpeg.

echo "Starting clean worker; pid file: ${DEMO_WORKER_PID_FILE}" >&2
echo "  concurrency=${DEMO_WORKER_MAX_CONCURRENT_ACTIVITIES}" >&2

if [[ -f "$env_file" ]]; then
  exec uv run --env-file "$env_file" openai_agents/run_worker.py
fi

exec uv run openai_agents/run_worker.py
